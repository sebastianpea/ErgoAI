# ============================================================================
# ErgoAI — Configuración Unificada del Sistema (Plantilla .env.example)
# Copie este archivo a `.env` para personalizar la configuración del entorno.
# ============================================================================

# --- Servidor Backend (FastAPI / Uvicorn) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# Lista de orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:80,http://localhost

# --- Rutas del Sistema de Archivos (Persistencia Cero Base de Datos) ---
# Por defecto se resuelven relativamente a la raíz del repositorio ErgoAI/
# CONFIG_NORMATIVO_DIR=/app/config_normativo
# WORKSPACE_DIR=/app/casos_jabil_workspace
# VISION_MODELOS_DIR=/app/models

# --- Identidades de Auditoría y Trazabilidad (Bitácora SHA-256) ---
USUARIO_POR_DEFECTO=Ing. Ergonomía
USUARIO_SISTEMA=sistema

# --- Motor RAG en Memoria (BM25 Lexical Retriever / Sin Vector DB) ---
BM25_K1=1.2
BM25_B=0.75

# --- Motor LLM Local / Cloud (Agnóstico del Proveedor) ---
# Proveedores disponibles: OLLAMA | GEMINI | OPENAI
LLM_PROVIDER=OLLAMA
# Modelo por defecto (en Ollama: qwen2.5, qwen2.5-coder, etc.)
MODEL_NAME=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
OLLAMA_TAG_TIMEOUT_SEC=1.5

# Si usa LLM_PROVIDER=GEMINI:
# GEMINI_API_KEY=tu_clave_api_gemini
# ERGOAI_GEMINI_MODEL=gemini-2.5-pro

# Si usa LLM_PROVIDER=OPENAI:
# OPENAI_API_KEY=tu_clave_api_openai
# ERGOAI_OPENAI_MODEL=gpt-4o-mini

# --- Pipeline de Visión Computacional 2D (YOLOX + RTMPose ONNX) ---
# Dispositivo de cómputo para ONNX Runtime: "cpu" o "cuda" (GPU NVIDIA)
VISION_DISPOSITIVO=cpu
VISION_CONFIANZA_MIN=0.30
VISION_CONFIANZA_RESPALDO=0.15
VISION_MIN_PUNTOS_RESPALDO=5
VISION_LADO_MAXIMO_PX=1600
VISION_STD_MINIMA_IMAGEN=3.0
VISION_DOWNLOAD_TIMEOUT_SEC=120
MAX_FOTO_MB=15.0
CALIDAD_JPEG=90

# --- Frontend (Vite / Nginx) ---
FRONTEND_PORT=5180
# En desarrollo Vite hace proxy hacia BACKEND_PORT y en Docker Nginx hace reverse proxy.
# Deje VITE_API_URL vacío para aprovechar rutas relativas transparentes (/casos, /salud):
# VITE_API_URL=
VITE_USER_ERGONOMIA=esp.ergonomia@jabil.com
VITE_USER_INGENIERIA=ing.martinez@jabil.com

# --- Puertos de Docker Compose ---
OLLAMA_PORT=11434
