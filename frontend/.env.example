# ============================================================================
# ErgoAI Frontend — Variables de Entorno (Plantilla .env.example)
# ============================================================================

# false = conectar al backend real vía API_URL o Proxy reverso.
# true  = modo presentación sin backend (datos simulados en memoria mocks/data.ts).
VITE_USE_MOCK=false

# URL base del API Backend.
# IMPORTANTE: Déjelo vacío para que las peticiones usen rutas relativas (/casos, /salud, etc.)
# canalizadas a través del proxy de Vite en desarrollo o el reverse proxy de Nginx en Docker.
# Únicamente especifique una URL completa si el frontend y el backend se alojan en dominios
# o puertos distintos sin ningún proxy intermedio.
VITE_API_URL=

# Puerto de destino del backend para el proxy inverso de desarrollo en Vite (vite.config.ts)
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
VITE_PORT=5173

# Identidades por defecto para cambio rápido de rol en interfaz (barra superior)
VITE_USER_ERGONOMIA=esp.ergonomia@jabil.com
VITE_USER_INGENIERIA=ing.martinez@jabil.com
